# Copy this file to packages/server/.env and fill it in. That file is gitignored.
# pnpm start loads this file and does not override variables already set.
# Do not put real secret values in this example.

PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=errant-tower
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Errant Tower
CORS_ORIGINS=http://localhost:5174
COOKIE_SECRET=replace-with-at-least-32-random-characters
